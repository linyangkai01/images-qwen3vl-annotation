{
  "project_name": "工业施工安全隐患自动标注（实验室私有 VLM 途径）",
  "scene": "施工现场单路固定机位监控视频，覆盖吊装作业与高处作业，关注吊索具、被吊物、人员 PPE 与梯具使用",
  "run_mode": "quick",
  "labels": [
    "person",
    "helmet",
    "vest",
    "harness",
    "hook",
    "rigging",
    "overhead_crane",
    "load",
    "ladder",
    "scaffold",
    "guardrail",
    "pallet"
  ],
  "input": {
    "frames_dir": "input/frames"
  },
  "output": {
    "workspace_dir": "workspace"
  },
  "pipeline": {
    "frame_step": 1,
    "max_frames_per_source": 500,
    "min_detection_confidence": 0.25,
    "review_confidence_threshold": 0.8,
    "include_empty_frames": true,
    "include_review_queue_in_training": false,
    "train_split": 0.7,
    "val_split": 0.2,
    "test_split": 0.1,
    "seed": 7
  },
  "video": {
    "video_path": "input/video/site_monitor.mp4",
    "sample_fps": 1.0,
    "scale_width": 960,
    "analysis_width": 160,
    "decode_backend": "ffmpeg",
    "ffmpeg_binary": "ffmpeg"
  },
  "keyframe": {
    "enable": true,
    "motion_min_ratio": 0.002,
    "pixel_delta_threshold": 25,
    "dedup_hamming_threshold": 4,
    "phash_size": 8,
    "scene_change_threshold": 0.4,
    "scene_detect_mode": "ffmpeg",
    "max_keyframes": 400,
    "min_gap_seconds": 2.0,
    "force_keep_labels": ["person", "hook", "rigging", "overhead_crane", "ladder", "scaffold", "harness", "load"]
  },
  "knowledge": {
    "kb_path": "",
    "kb_mode": "compressed",
    "kb_max_chars": 8000,
    "scene_routing": "rules",
    "include_ten_no_lift": true,
    "include_crane_six_forbidden": true
  },
  "hazard": {
    "output_dir": "workspace/hazards",
    "severity_levels": {},
    "overall_risk_policy": "max"
  },
  "visualization": {
    "enable": true,
    "output_dir": "workspace/visualization",
    "thumbnail_size": 160
  },
  "inference": {
    "backend": "private_vlm",
    "max_video_seconds": 60,
    "on_over_limit": "warn",
    "segment_seconds": 55,
    "server": {
      "host": "lab-server",
      "remote_dir": "/data/users/lyk/.tmp/yolo-inference",
      "activate_script": "/data/users/lyk/activate-hazard.sh",
      "confidence": 0.25,
      "iou": 0.45,
      "image_size": 1280,
      "device": "0",
      "timeout_seconds": 1800
    }
  },
  "qwen": {
    "provider": "private_vlm",
    "base_url": "http://119.23.145.227:38091",
    "endpoint": "",
    "request_path": "/api/generate",
    "prompt_template": "assets/prompts/combined_zh.md",
    "model": "qwen3-vl:30b-a3b-thinking-q8_0",
    "api_key_env": "LAB_VLM_TOKEN",
    "require_api_key": true,
    "timeout_seconds": 600,
    "max_retries": 2,
    "retry_backoff_seconds": 2.0,
    "temperature": 0.7,
    "top_p": 0.9,
    "max_tokens": 8192,
    "response_format": "json_object",
    "auth_scheme": "Bearer",
    "headers": {},
    "header_env": {},
    "extra_body": {},
    "enable_thinking": true,
    "strip_thinking": true,
    "json_repair": true,
    "combined_call": true,
    "concurrency": 1,
    "images_mode": "array",
    "stream": false,
    "options": {
      "temperature": 0.7,
      "max_tokens": 8192
    }
  },
  "yolo": {
    "binary": "yolo",
    "task": "detect",
    "detector": "ultralytics",
    "trainer": "ultralytics",
    "detector_weights": "weights/hazard_yolo.pt",
    "weights": "weights/yolo11n.pt",
    "detector_confidence": 0.25,
    "detector_iou": 0.45,
    "detector_image_size": 1280,
    "image_size": 640,
    "epochs": 100,
    "device": "0",
    "batch": 16,
    "workers": 8,
    "patience": 30,
    "cache": false,
    "resume": false,
    "close_mosaic": 10,
    "save_period": -1
  }
}
