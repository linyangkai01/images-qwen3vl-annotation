{
  "project_name": "工业施工安全隐患自动标注（mock 演示项目）",
  "scene": "施工现场吊装作业与高处作业监控画面，关注吊索具、被吊物、人员 PPE 与梯具使用",
  "run_mode": "quick",
  "labels": [
    "person",
    "helmet",
    "vest",
    "harness",
    "hook",
    "rigging",
    "overhead_crane",
    "load",
    "ladder",
    "scaffold",
    "guardrail",
    "pallet"
  ],
  "input": {
    "frames_dir": "input/frames"
  },
  "output": {
    "workspace_dir": "workspace"
  },
  "pipeline": {
    "frame_step": 1,
    "max_frames_per_source": 50,
    "min_detection_confidence": 0.25,
    "review_confidence_threshold": 0.8,
    "include_empty_frames": true,
    "include_review_queue_in_training": false,
    "train_split": 0.7,
    "val_split": 0.2,
    "test_split": 0.1,
    "seed": 7
  },
  "video": {
    "video_path": "",
    "sample_fps": 0.5,
    "scale_width": 640,
    "analysis_width": 160,
    "decode_backend": "ffmpeg",
    "ffmpeg_binary": "ffmpeg"
  },
  "keyframe": {
    "enable": true,
    "motion_min_ratio": 0.0,
    "pixel_delta_threshold": 25,
    "dedup_hamming_threshold": 0,
    "phash_size": 8,
    "scene_change_threshold": 0.4,
    "scene_detect_mode": "histogram",
    "max_keyframes": 30,
    "min_gap_seconds": 0.0
  },
  "knowledge": {
    "kb_path": "",
    "kb_mode": "compressed",
    "kb_max_chars": 8000,
    "scene_routing": "rules",
    "include_ten_no_lift": true,
    "include_crane_six_forbidden": true
  },
  "hazard": {
    "output_dir": "workspace/hazards",
    "severity_levels": {},
    "overall_risk_policy": "max"
  },
  "visualization": {
    "enable": true,
    "output_dir": "workspace/visualization",
    "thumbnail_size": 160
  },
  "qwen": {
    "provider": "mock",
    "base_url": "",
    "endpoint": "",
    "prompt_template": "assets/prompts/combined_zh.md",
    "model": "qwen3-vl:30b-a3b-thinking-q8_0",
    "api_key_env": "QWEN_API_KEY",
    "require_api_key": false,
    "timeout_seconds": 90,
    "max_retries": 1,
    "temperature": 0.1,
    "top_p": 0.9,
    "max_tokens": 1500,
    "response_format": "json_object",
    "enable_thinking": false,
    "strip_thinking": true,
    "json_repair": true,
    "combined_call": true,
    "concurrency": 1
  },
  "yolo": {
    "binary": "yolo",
    "task": "detect",
    "detector": "sidecar",
    "trainer": "mock",
    "weights": "weights/yolo11n.pt",
    "image_size": 1280,
    "epochs": 50
  }
}