.workbuddy-ai/

# ---------------------------------------------------------------------------
# 隐私铁律：真实图片 / 视频一律不入库
#   真实素材统一存放在 D:\WorkPlace\industrial-data\，不得复制进本仓库。
#   下列规则为兜底，防止素材被放进 input/ 后被 git 跟踪。
# ---------------------------------------------------------------------------
examples/*/input/
examples/*/weights/
*.mp4
*.mov
*.qt
*.avi
*.mkv
*.flv
*.wmv
*.ppm
*.pgm
*.pbm
*.bmp
*.tif
*.tiff

# 历史遗留的具体批次目录（保留以兼容旧记录）
tupian/
examples/production_project/weights/
examples/production_project/input/frames/video_batch_20260713_30572/
examples/production_project/input/frames/user_batch_20260712/

# ---------------------------------------------------------------------------
# 运行产物（workspace 下均为可再生产物）
# ---------------------------------------------------------------------------
examples/mock_project/workspace/
examples/production_project/workspace/
examples/hazard_mock_project/workspace/
examples/hazard_project/workspace/
workspace/

# 知识库备份（回滚用，不入库）
hazard-detection/*.bak-*

# ---------------------------------------------------------------------------
# 临时 / 调试残留
# ---------------------------------------------------------------------------
.tmp-video-test/
_tmp/
*.tmp

# 根目录下 QA / 调试用的下划线脚本与日志（历史一次性产物）
# 注意：必须用前导 / 锚定根目录，否则 _*.py 会误伤 __init__.py / __main__.py
/_*.py
/_*.log
/_*.txt
/_*.out
/_*.json

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# industrial_hazard_coldstart：自有 / 开源子树隔离
#   own/*/input/     —— 真实素材派生数据（关键帧），绝不入库
#   own/*/workspace/ —— 运行产物，可再生产物
#   open/weights/    —— 下载的开源权重，不入库
# ---------------------------------------------------------------------------
own/*/input/
own/*/workspace/
open/weights/
